# Plantilla de variables de entorno.
# Copia este archivo como `.env` y ajusta los valores segun tu entorno.
# El archivo `.env` NO debe subirse al repositorio (ya esta en .gitignore).

# URL base del servicio Library
BASE_URL=https://rahulshettyacademy.com/Library/

# Tiempo maximo de respuesta aceptado (ms) para las aserciones de performance
MAX_RESPONSE_TIME_MS=500

# ID inexistente usado en casos negativos de GET/DELETE
NON_EXISTENT_ID=NO_EXISTE_000000000

# Flag de CI (habilita 2 retries, 1 worker y forbidOnly cuando es true)
CI=false
