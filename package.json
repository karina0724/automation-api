{
  "name": "library-api-tests",
  "version": "1.0.0",
  "description": "Automatización de pruebas funcionales e integración CRUD sobre el servicio REST https://rahulshettyacademy.com/Library usando Playwright + TypeScript.",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:functional": "playwright test tests/functional",
    "test:integration": "playwright test tests/integration",
    "test:addbook": "playwright test tests/functional/addBook.spec.ts",
    "test:getbook": "playwright test tests/functional/getBook.spec.ts",
    "test:deletebook": "playwright test tests/functional/deleteBook.spec.ts",
    "test:crud": "playwright test tests/integration/crud.spec.ts",
    "report": "playwright show-report"
  },
  "keywords": [
